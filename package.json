{
  "name": "horcrux-file-system",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "bun --cwd apps/web dev",
    "dev:api": "bun --cwd apps/api dev",
    "build:web": "bun --cwd apps/web build",
    "build:api": "bun --cwd apps/api build",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:js": "bun test",
    "test:e2e": "bun run scripts/e2e-local.ts",
    "db:migrate:local": "bun --cwd apps/api db:migrate:local"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
